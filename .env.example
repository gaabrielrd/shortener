# Variáveis de ambiente do projeto.
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca faça commit de .env.local — ele está no .gitignore.

# Prefixo VITE_ é obrigatório para expor a variável ao front-end.
# Todo valor enviado ao browser é público; não use este arquivo para segredos.

# A leitura e a validação ficam em src/shared/config/env.ts. Ao criar uma
# variável nova: declare-a em ImportMetaEnv (src/vite-env.d.ts), exponha-a em
# `Env` e, se for obrigatória, acrescente a chave em REQUIRED_KEYS. Assim uma
# configuração ausente falha no boot, com mensagem clara.

# Configuração pública do Firebase Web. Os valores abaixo são placeholders;
# para desenvolvimento local, prefira um projeto Firebase com prefixo demo-.
VITE_FIREBASE_API_KEY=chave-publica-do-app
VITE_FIREBASE_AUTH_DOMAIN=demo-shortener.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-shortener
VITE_FIREBASE_STORAGE_BUCKET=demo-shortener.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_USE_EMULATORS=true

# Origem pública usada para montar os links curtos, sem barra final.
VITE_PUBLIC_SHORT_BASE_URL=http://localhost:5173

# VITE_API_URL=https://api.exemplo.com
